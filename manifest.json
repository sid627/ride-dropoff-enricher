{
  "manifest_version": 3,
  "name": "BlaBlaCar Exact Destination — Page Scraper",
  "version": "4.0.0",
  "description": "Reads arrival addresses from normal public ride pages and adds a concise destination beside each search result city.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.blablacar.in/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.blablacar.in/search*"],
      "js": ["results.js"],
      "run_at": "document_idle"
    }
  ]
}
